# Name shown in WhatsApp replies and the dashboard
BOT_NAME=Air Agent

# Default open-source model served by Ollama on this server. Pick by server RAM:
#   4 GB -> qwen2.5:1.5b  |  8 GB -> qwen2.5:3b or llama3.2:3b  |  16 GB+ -> qwen2.5:7b
# (Admins can also switch models or point the server at an API from the Admin page.)
MODEL=qwen2.5:1.5b
NUM_CTX=4096
HISTORY_TURNS=12

# Public port for the dashboard (http://YOUR_IP:8080)
PUBLIC_PORT=8080

# Messages per minute allowed from one sender
RATE_LIMIT_PER_MIN=12

# Delete chat memory older than N days (0 = never)
RETENTION_DAYS=30

# auto = secure cookies whenever the site is opened over HTTPS
COOKIE_SECURE=auto

# Password reset links use this fixed HTTPS origin. Set it to the site's actual origin.
PUBLIC_URL=https://agent.example.com

# Optional fixed key used to encrypt stored API keys/passwords (otherwise generated in the data volume)
# Do not set or change this on an existing data volume without a tested key migration.
# APP_SECRET=

# Local speech-to-text model for voice notes (open-source Whisper)
WHISPER_MODEL=onnx-community/whisper-base

# Max upload size for knowledge files (MB)
MAX_UPLOAD_MB=15

# Sign-ups are controlled on the Admin page (off by default). Only for testing:
# FORCE_OPEN_SIGNUP=true
