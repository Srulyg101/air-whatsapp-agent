# Name shown in WhatsApp replies and the dashboard
BOT_NAME=Air Agent

# Open-source model served by Ollama. Pick by server RAM:
#   4 GB  -> qwen2.5:1.5b   |  8 GB -> qwen2.5:3b or llama3.2:3b  |  16 GB+ -> qwen2.5:7b or llama3.1:8b
MODEL=qwen2.5:1.5b
NUM_CTX=4096
HISTORY_TURNS=12

# Dashboards listen only on the server loopback IP by default.
# Access with an SSH tunnel (ssh -L 8080:127.0.0.1:8080 -L 3001:127.0.0.1:3001 user@VPS_IP).
# To publish behind a secured HTTPS proxy, retain BIND_IP=127.0.0.1.
BIND_IP=127.0.0.1
PUBLIC_PORT=8080

# Never allow public registration by default.
OPEN_SIGNUP=false
# REQUIRED to create the first admin: unique 24+ character random value.
# Set privately in the deployment environment; do not commit the real token to GitHub.
BOOTSTRAP_ADMIN_TOKEN=

# Messages per minute allowed from one sender
RATE_LIMIT_PER_MIN=12

# Delete chat memory older than N days (0 = never)
RETENTION_DAYS=30

# Always use HTTPS for normal operation. Secure cookies won't be set on insecure HTTP.
COOKIE_SECURE=true
# For localhost-only development over HTTP: temporarily use COOKIE_SECURE=false,
# and never open the dashboard on a public IP in this mode.

# Optional: override the base personality ({BOT_NAME} is replaced)
# SYSTEM_PROMPT=You are {BOT_NAME}...

# Optional bot email. A verified domain, provider configuration and inbound mail relay
# are required before email can send or receive; keys stay ONLY in private VPS secrets.
MAIL_DOMAIN=
EMAIL_FROM=
RESEND_API_KEY=
# Generate 32+ random characters. Signed webhook needs X-Air-Timestamp and X-Air-Signature.
INBOUND_EMAIL_WEBHOOK_SECRET=
